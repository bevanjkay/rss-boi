{
  "name": "@rss-boi/api",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/prisma && cp -R ../../prisma/generated dist/prisma",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "users:create": "tsx src/cli/index.ts users:create",
    "users:disable": "tsx src/cli/index.ts users:disable",
    "users:reset-password": "tsx src/cli/index.ts users:reset-password"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@rss-boi/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
