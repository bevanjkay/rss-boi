NODE_ENV=development
LOG_LEVEL=debug
POSTGRES_DB=rssboi
POSTGRES_USER=rssboi
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://rssboi:changeme@postgres:5432/rssboi?schema=public
SESSION_SECRET=replace-me-with-a-long-random-string
API_PORT=3001
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
# Outbound fetches to private/loopback/reserved addresses are blocked to
# prevent SSRF. To use a feed generator on your LAN or compose network (e.g.
# RSSHub), allowlist just that host instead of opening the whole private range.
# Comma-separated; each entry is an IP, IPv4 CIDR, or hostname, with an
# optional :port to restrict it further. Examples:
#   ALLOW_PRIVATE_HOSTS=192.168.86.199:1200
#   ALLOW_PRIVATE_HOSTS=rsshub:1200,192.168.86.0/24
ALLOW_PRIVATE_HOSTS=
# Blunt escape hatch: disables the private-address check entirely, including
# for images embedded in feed content. Prefer ALLOW_PRIVATE_HOSTS.
ALLOW_PRIVATE_NETWORK=false
